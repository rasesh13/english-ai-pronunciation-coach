# Server-only credentials. Never expose these through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
RIME_API_KEY=
RIME_MODEL=coda
RIME_VOICE=astra
RIME_LANGUAGE=en-US
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts

# Next.js -> FastAPI server boundary.
FASTAPI_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production persistence. PostgreSQL automatically enables the pgvector extension.
# The local fallback is sqlite:///./data/english-ai.db
DATABASE_URL=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

LLM_API_KEY=
STT_API_KEY=

# Optional override. Defaults to ./data/orbit.json.
ORBIT_DATA_FILE=
